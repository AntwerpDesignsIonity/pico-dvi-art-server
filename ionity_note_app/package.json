{
  "name": "ionity-pico-note-display",
  "version": "4.0.0",
  "description": "Ionity Pico Note-Display - push notes to the scripture display",
  "main": "main.js",
  "author": "Ionity Global Pty Ltd",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.ionityglobal.piconotedisplay",
    "productName": "Ionity Pico Note-Display",
    "icon": "assets/ionity.ico",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "assets/**"],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/ionity.ico"
    },
    "portable": { "artifactName": "IonityPicoNoteDisplay-${version}-portable.exe" },
    "nsis": { "artifactName": "IonityPicoNoteDisplay-${version}-setup.exe", "oneClick": true }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
